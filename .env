# ── Application ───────────────────────────────────────────
APP_NAME=Auralis
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ── LLM Provider ──────────────────────────────────────────
# Change to "openai" and set OPENAI_API_KEY for real AI responses
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embedding (offline, no API key needed) ─────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=auralis_knowledge

# ── RAG ───────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3

# ── Conversation ──────────────────────────────────────────
MAX_CONVERSATION_TURNS=20
